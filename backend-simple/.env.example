# Database Configuration
DATABASE_URL=postgresql://docker_manager:docker_manager@postgres:5432/docker_manager
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=6500

# CORS Configuration
CORS_ORIGINS=["http://localhost:3050", "http://frontend:3050"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ALL_ORIGINS=false

# Cache Configuration
CACHE_TTL_SECONDS=10

# Redis Configuration (when implemented)
REDIS_URL=redis://redis:6379/0

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Configuration
DOCKER_COLLECTION_INTERVAL=5
DOCKER_CLEANUP_INTERVAL=3600

# Application Configuration
APP_NAME="Docker Manager API"
APP_VERSION="0.1.0"
DEBUG=false

# Profiling Configuration (development only)
ENABLE_PROFILER=false
PROFILER_SLOW_REQUEST_THRESHOLD_MS=1000
