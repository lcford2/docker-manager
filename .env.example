# Admin User Configuration
# Set these values before first launch to configure the initial admin user
# ============================================
# Docker Manager - Environment Variables
# ============================================
# These contain sensitive secrets that should NOT be committed to git.
# Copy this file to .env and update with your actual values.
#
# HOW .ENV IS LOADED:
# - Development: The backend automatically loads .env file via dotenvy
# - Docker: docker-compose.yml reads .env and passes vars to containers
# - Both methods work together for maximum flexibility

# JWT Secret - Use a long random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# Database Password
DB_PASSWORD=your-database-password

# Admin User Initial Setup (used by database/create_admin_user.sh)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# Application Environment (development, production)
RUST_ENV=production
